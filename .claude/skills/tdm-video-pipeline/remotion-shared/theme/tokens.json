{
  "$schema": "https://design-tokens.org/schema.json",
  "$name": "Tram Dung Mlem Universal Theme",
  "$version": "1.0.0",
  "$lastUpdated": "2026-04-29",
  "$description": "Universal design tokens for Trạm Dừng Mlem — works across Remotion video (1080×1920), web, email, print/poster. Direction A: Playful Foodtoon.",

  "color": {
    "brand": {
      "yellow":  { "$value": "#F8B147", "$type": "color", "$description": "Mlem Yellow — primary brand, CTA, karaoke highlight" },
      "orange":  { "$value": "#F39820", "$type": "color", "$description": "Mlem Orange — gradient stop, hover, fur color" },
      "coral":   { "$value": "#E85D2F", "$type": "color", "$description": "Mlem Coral — hot accent, fact pop" },
      "red":     { "$value": "#C8302D", "$type": "color", "$description": "Pizza Red — shock, warning" },
      "teal":    { "$value": "#4FC3D1", "$type": "color", "$description": "Mlem Teal — cool, link" },
      "cream":   { "$value": "#FFF4E0", "$type": "color", "$description": "Surface cream — caption bg, paper" }
    },

    "pillar": {
      "a": {
        "name": "Khẩu phần đặc thù",
        "light": { "$value": "#FFE0A8", "$type": "color", "$description": "Pillar A light — bg, hover" },
        "base":  { "$value": "#F8B147", "$type": "color", "$description": "Pillar A base — accent, badge" },
        "dark":  { "$value": "#B87808", "$type": "color", "$description": "Pillar A dark — text on light, hover deep" }
      },
      "b": {
        "name": "Món lạ quốc gia",
        "light": { "$value": "#F4B0AE", "$type": "color" },
        "base":  { "$value": "#C8302D", "$type": "color" },
        "dark":  { "$value": "#7A1614", "$type": "color" }
      },
      "c": {
        "name": "Kỷ lục & Cực đoan",
        "light": { "$value": "#F9C5AE", "$type": "color" },
        "base":  { "$value": "#E85D2F", "$type": "color" },
        "dark":  { "$value": "#8E2F0F", "$type": "color" }
      },
      "d": {
        "name": "Văn hóa & Cách làm",
        "light": { "$value": "#BEE7ED", "$type": "color" },
        "base":  { "$value": "#4FC3D1", "$type": "color" },
        "dark":  { "$value": "#1F6E79", "$type": "color" }
      }
    },

    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color", "$description": "Pure white" },
      "50":  { "$value": "#FFFAF0", "$type": "color", "$description": "Warm off-white, page bg" },
      "200": { "$value": "#EFE6D2", "$type": "color", "$description": "Warm divider, soft border" },
      "400": { "$value": "#A89C84", "$type": "color", "$description": "Muted text, placeholder" },
      "600": { "$value": "#5C5443", "$type": "color", "$description": "Body text on light" },
      "800": { "$value": "#2B2620", "$type": "color", "$description": "Heading on light" },
      "900": { "$value": "#1A1A1A", "$type": "color", "$description": "Outline / on-brand black" }
    },

    "semantic": {
      "fg": {
        "primary":   { "$value": "{color.neutral.900}", "$type": "color" },
        "secondary": { "$value": "{color.neutral.600}", "$type": "color" },
        "muted":     { "$value": "{color.neutral.400}", "$type": "color" },
        "inverted":  { "$value": "{color.neutral.0}",   "$type": "color" },
        "brand":     { "$value": "{color.brand.yellow}","$type": "color" },
        "link":      { "$value": "{color.brand.teal}",  "$type": "color" }
      },
      "bg": {
        "page":     { "$value": "{color.neutral.50}",   "$type": "color" },
        "surface":  { "$value": "{color.neutral.0}",    "$type": "color" },
        "subtle":   { "$value": "{color.brand.cream}",  "$type": "color" },
        "inverted": { "$value": "{color.neutral.900}",  "$type": "color" }
      },
      "border": {
        "subtle": { "$value": "{color.neutral.200}", "$type": "color" },
        "strong": { "$value": "{color.neutral.900}", "$type": "color", "$description": "Outline đen 4-6px chunky" }
      },
      "state": {
        "success": { "$value": "#3FB28E", "$type": "color" },
        "warning": { "$value": "{color.brand.coral}", "$type": "color" },
        "danger":  { "$value": "{color.brand.red}",   "$type": "color" },
        "info":    { "$value": "{color.brand.teal}",  "$type": "color" }
      },
      "outline": { "$value": "{color.neutral.900}", "$type": "color", "$description": "Universal outline đen" }
    },

    "dark": {
      "fg": {
        "primary":   { "$value": "{color.neutral.50}",  "$type": "color" },
        "secondary": { "$value": "{color.neutral.200}", "$type": "color" },
        "muted":     { "$value": "{color.neutral.400}", "$type": "color" }
      },
      "bg": {
        "page":     { "$value": "#16130E", "$type": "color" },
        "surface":  { "$value": "#221E16", "$type": "color" },
        "subtle":   { "$value": "#2E2820", "$type": "color" },
        "inverted": { "$value": "{color.neutral.50}", "$type": "color" }
      }
    }
  },

  "font": {
    "family": {
      "display": { "$value": "'Baloo 2', system-ui, sans-serif",        "$type": "fontFamily", "$description": "Hook, hero, mascot label" },
      "heading": { "$value": "'Be Vietnam Pro', system-ui, sans-serif", "$type": "fontFamily", "$description": "Title, lower-third" },
      "body":    { "$value": "'Be Vietnam Pro', system-ui, sans-serif", "$type": "fontFamily", "$description": "Caption, paragraph" },
      "mono":    { "$value": "'JetBrains Mono', ui-monospace, monospace","$type": "fontFamily", "$description": "Number, code, stat" }
    },
    "weight": {
      "regular":   { "$value": 400, "$type": "fontWeight" },
      "medium":    { "$value": 500, "$type": "fontWeight" },
      "semibold":  { "$value": 600, "$type": "fontWeight" },
      "bold":      { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" }
    },

    "video": {
      "$description": "Pixel sizes for Remotion 1080×1920 9:16 — DO NOT scale by viewport",
      "hookXL":   { "$value": 140, "$type": "dimension", "lineHeight": 1.0,  "weight": 800, "family": "display", "use": "Hook 0-3s, 1-3 từ" },
      "hookL":    { "$value": 96,  "$type": "dimension", "lineHeight": 1.05, "weight": 800, "family": "display", "use": "Hook 0-3s, 4-7 từ" },
      "title":    { "$value": 72,  "$type": "dimension", "lineHeight": 1.1,  "weight": 800, "family": "display", "use": "Cover, lower-third" },
      "subtitle": { "$value": 48,  "$type": "dimension", "lineHeight": 1.2,  "weight": 700, "family": "heading", "use": "Lower-third sub, fact pop" },
      "body":     { "$value": 40,  "$type": "dimension", "lineHeight": 1.4,  "weight": 500, "family": "body",    "use": "Karaoke caption" },
      "monoStat": { "$value": 120, "$type": "dimension", "lineHeight": 1.0,  "weight": 600, "family": "mono",    "use": "Số liệu lớn" },
      "tag":      { "$value": 28,  "$type": "dimension", "lineHeight": 1.2,  "weight": 700, "family": "heading", "use": "Pillar badge, hashtag" }
    },

    "web": {
      "$description": "rem-based for responsive web (1rem = 16px). Scale matches video vibe.",
      "5xl": { "$value": "4.5rem",   "$type": "dimension", "lineHeight": 1.0,  "weight": 800, "family": "display", "use": "Hero web (~72px)" },
      "4xl": { "$value": "3rem",     "$type": "dimension", "lineHeight": 1.05, "weight": 800, "family": "display", "use": "Section title (~48px)" },
      "3xl": { "$value": "2.25rem",  "$type": "dimension", "lineHeight": 1.1,  "weight": 800, "family": "display", "use": "Card title (~36px)" },
      "2xl": { "$value": "1.75rem",  "$type": "dimension", "lineHeight": 1.2,  "weight": 700, "family": "heading", "use": "Subhead (~28px)" },
      "xl":  { "$value": "1.375rem", "$type": "dimension", "lineHeight": 1.3,  "weight": 700, "family": "heading", "use": "Lead (~22px)" },
      "lg":  { "$value": "1.125rem", "$type": "dimension", "lineHeight": 1.5,  "weight": 500, "family": "body",    "use": "Body large (~18px)" },
      "md":  { "$value": "1rem",     "$type": "dimension", "lineHeight": 1.5,  "weight": 500, "family": "body",    "use": "Body default (~16px)" },
      "sm":  { "$value": "0.875rem", "$type": "dimension", "lineHeight": 1.45, "weight": 500, "family": "body",    "use": "Caption (~14px)" },
      "xs":  { "$value": "0.75rem",  "$type": "dimension", "lineHeight": 1.4,  "weight": 600, "family": "heading", "use": "Tag, label (~12px)" }
    },

    "stroke": {
      "outline":      { "$value": 4, "$type": "dimension", "color": "{color.neutral.900}", "use": "Body/subtitle text on image" },
      "outlineHook":  { "$value": 6, "$type": "dimension", "color": "{color.neutral.900}", "use": "Hook XL/L text on image" },
      "outlineThin":  { "$value": 2, "$type": "dimension", "color": "{color.neutral.900}", "use": "Web web small badge text" }
    }
  },

  "spacing": {
    "0":  { "$value": 0,  "$type": "dimension" },
    "1":  { "$value": 4,  "$type": "dimension" },
    "2":  { "$value": 8,  "$type": "dimension" },
    "3":  { "$value": 12, "$type": "dimension" },
    "4":  { "$value": 16, "$type": "dimension" },
    "5":  { "$value": 20, "$type": "dimension" },
    "6":  { "$value": 24, "$type": "dimension" },
    "8":  { "$value": 32, "$type": "dimension" },
    "10": { "$value": 40, "$type": "dimension" },
    "12": { "$value": 48, "$type": "dimension" },
    "16": { "$value": 64, "$type": "dimension" },
    "20": { "$value": 80, "$type": "dimension" },
    "24": { "$value": 96, "$type": "dimension" }
  },

  "radius": {
    "xs":   { "$value": 4,   "$type": "dimension", "use": "Small badge, tag" },
    "sm":   { "$value": 6,   "$type": "dimension", "use": "Highlight word, chip" },
    "md":   { "$value": 12,  "$type": "dimension", "use": "Card, input" },
    "lg":   { "$value": 16,  "$type": "dimension", "use": "Fact pop card" },
    "xl":   { "$value": 24,  "$type": "dimension", "use": "Hero, section" },
    "2xl":  { "$value": 32,  "$type": "dimension", "use": "Large hero, sticker" },
    "pill": { "$value": 999, "$type": "dimension", "use": "Pillar badge, button" }
  },

  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "stickerSm": {
      "$value": "3px 3px 0 0 #1A1A1A",
      "$type": "shadow",
      "use": "Small button, badge — chunky sticker vibe"
    },
    "stickerMd": {
      "$value": "6px 6px 0 0 #1A1A1A",
      "$type": "shadow",
      "use": "Card, lower-third, hook text drop shadow (default sticker pop)"
    },
    "stickerLg": {
      "$value": "10px 10px 0 0 #1A1A1A",
      "$type": "shadow",
      "use": "Hero CTA, large feature card, sticker XL"
    },
    "softSm": {
      "$value": "0 2px 4px rgba(26,26,26,0.08)",
      "$type": "shadow",
      "use": "Subtle web card — soft mode (rare in brand)"
    },
    "softMd": {
      "$value": "0 8px 24px rgba(26,26,26,0.10)",
      "$type": "shadow",
      "use": "Modal, dropdown — soft mode"
    },
    "innerInset": {
      "$value": "inset 0 -3px 0 0 #1A1A1A",
      "$type": "shadow",
      "use": "Pressed button base"
    }
  },

  "border": {
    "none":  { "$value": 0, "$type": "dimension" },
    "thin":  { "$value": 2, "$type": "dimension", "use": "Small badge web" },
    "base":  { "$value": 3, "$type": "dimension", "use": "Default chunky" },
    "thick": { "$value": 4, "$type": "dimension", "use": "Card, hero" },
    "xthick":{ "$value": 6, "$type": "dimension", "use": "Hook frame, large container" }
  },

  "composition": {
    "video": {
      "tiktok":     { "width": 1080, "height": 1920, "fps": 30, "aspect": "9:16" },
      "youtubeHd":  { "width": 1920, "height": 1080, "fps": 30, "aspect": "16:9" },
      "instaSquare":{ "width": 1080, "height": 1080, "fps": 30, "aspect": "1:1" }
    },
    "web": {
      "containerSm": { "$value": 640,  "$type": "dimension" },
      "containerMd": { "$value": 768,  "$type": "dimension" },
      "containerLg": { "$value": 1024, "$type": "dimension" },
      "containerXl": { "$value": 1280, "$type": "dimension" },
      "container2xl":{ "$value": 1536, "$type": "dimension" }
    },
    "print": {
      "posterA3":    { "width": 297,  "height": 420, "unit": "mm", "dpi": 300 },
      "thumbnailYt": { "width": 1280, "height": 720, "unit": "px" }
    }
  },

  "motion": {
    "duration": {
      "instant": { "$value": 100, "$type": "duration", "unit": "ms" },
      "fast":    { "$value": 180, "$type": "duration", "unit": "ms" },
      "base":    { "$value": 280, "$type": "duration", "unit": "ms" },
      "slow":    { "$value": 430, "$type": "duration", "unit": "ms", "use": "Total Zoom Punch transition" },
      "slower":  { "$value": 700, "$type": "duration", "unit": "ms" }
    },
    "easing": {
      "linear":     { "$value": "linear",                            "$type": "cubicBezier" },
      "standard":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",      "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.7, 0, 0.84, 0)",     "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0.2, 1)",        "$type": "cubicBezier" },
      "bounce":     { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier", "use": "Pop-in mascot, sticker entry" }
    },
    "spring": {
      "logoBounce":  { "stiffness": 180, "damping": 12, "use": "Logo intro" },
      "hookSlide":   { "stiffness": 120, "damping": 14, "use": "Hook text slide-up" },
      "mascotPop":   { "stiffness": 200, "damping": 10, "use": "Mascot reaction sticker entry" },
      "buttonPress": { "stiffness": 300, "damping": 20, "use": "Web hover/click" }
    },
    "transition": {
      "zoomPunchWhip": {
        "$description": "Signature scene transition — 13 frames @ 30fps",
        "totalFrames": 13,
        "totalMs": 433,
        "phases": [
          { "name": "zoomIn",       "frames": 4, "scaleFrom": 1.0,  "scaleTo": 1.15, "easing": "standard" },
          { "name": "hold",         "frames": 2, "easing": "linear" },
          { "name": "whipBlurCut",  "frames": 3, "blurFrom": 0,     "blurTo": 30,    "easing": "accelerate" },
          { "name": "zoomOutEnter", "frames": 4, "scaleFrom": 1.15, "scaleTo": 1.0,  "easing": "decelerate" }
        ]
      }
    },
    "preset": {
      "hoverPop": {
        "$description": "Web hover — chunky lift + shadow grow",
        "transform": "translate(-2px, -2px)",
        "shadow":    "{shadow.stickerLg}",
        "duration":  "{motion.duration.fast}",
        "easing":    "{motion.easing.bounce}"
      },
      "clickPress": {
        "$description": "Web active — chunky press into shadow",
        "transform": "translate(3px, 3px)",
        "shadow":    "none",
        "duration":  "{motion.duration.instant}",
        "easing":    "{motion.easing.standard}"
      },
      "fadeUp": {
        "$description": "Section entry on scroll",
        "from":     { "opacity": 0, "transform": "translateY(20px)" },
        "to":       { "opacity": 1, "transform": "translateY(0)" },
        "duration": "{motion.duration.base}",
        "easing":   "{motion.easing.decelerate}"
      },
      "bounceIn": {
        "$description": "Mascot/sticker entry",
        "from":     { "opacity": 0, "transform": "scale(0)" },
        "midKeyframe": { "scale": 1.1 },
        "to":       { "opacity": 1, "transform": "scale(1)" },
        "duration": "{motion.duration.slow}",
        "easing":   "{motion.easing.bounce}"
      }
    },
    "captionKaraoke": {
      "highlightFadeInFrames":  2,
      "highlightFadeOutFrames": 3,
      "highlightBg":            "{color.brand.yellow}",
      "highlightRadius":        "{radius.sm}",
      "highlightPadding":       { "x": 12, "y": 4 }
    },
    "factPop": {
      "popInFrames":     8,
      "popInScales":     [0, 1.2, 1.0],
      "popOutFrames":    4,
      "holdDurationSec": [1.5, 2.5]
    }
  },

  "sound": {
    "library": {
      "whoosh":     { "file": "assets/sfx/whoosh-01.mp3",   "volume": 0.55, "use": "Transition" },
      "impactHook": { "file": "assets/sfx/impact-boom.mp3", "volume": 0.6,  "use": "Hook reveal, shock fact" },
      "chimeFact":  { "file": "assets/sfx/chime-ting.mp3",  "volume": 0.5,  "use": "Fact pop, số liệu" },
      "mlemSting":  { "file": "assets/sfx/mlem-sting.mp3",  "volume": 0.7,  "use": "Intro/outro" },
      "popSticker": { "file": "assets/sfx/pop.mp3",         "volume": 0.5,  "use": "Mascot entry" }
    },
    "mix": { "voiceover": 1.0, "bgMusic": 0.18, "sfxDefault": 0.5 }
  },

  "photoTreatment": {
    "preset": "Vibrant Foodtoon",
    "saturation": 1.25,
    "contrast":   1.20,
    "highlights": 1.10,
    "shadows":    0.85,
    "vignette":   { "enabled": true, "amount": 0.10, "color": "#1A1A1A" },
    "grain":      0,
    "warmShift":  5,
    "outlineOverlay": { "enabled": true, "thickness": 3, "color": "#1A1A1A" }
  },

  "z": {
    "base":    { "$value": 0,    "$type": "number" },
    "raised":  { "$value": 10,   "$type": "number" },
    "sticky":  { "$value": 100,  "$type": "number" },
    "overlay": { "$value": 1000, "$type": "number" },
    "modal":   { "$value": 2000, "$type": "number" },
    "toast":   { "$value": 3000, "$type": "number" }
  }
}
