/**
 * Shared chrome for Bun Cha scenes.
 * - PhotoBackdrop: static photo (no Ken Burns) + dark vignette + pillar tint
 * - SubtitleKaraoke: outlined caption with yellow highlight on active words
 * - StickerCard: chunky outline + offset shadow card
 * - SceneFrame: per-scene container with optional pillar bg
 * - PillarBadge: top-left pillar tag
 * - useEntry: shared sticker pop entry spring
 * - useZoomPunch: 13-frame transition (zoom-in / hold / whip-blur / zoom-out)
 */

import React from 'react';
import {
  AbsoluteFill,
  Img,
  staticFile,
  useCurrentFrame,
  useVideoConfig,
  interpolate,
  spring,
} from 'remotion';
import { COLOR, FONT, FW, BORDER, RADIUS, SHADOW, SPACE, TYPE, outlineText, PILLAR_A } from './_theme';

// ───────── PHOTO BACKDROP (static, no Ken Burns) ─────────
export const PhotoBackdrop: React.FC<{
  src: string;
  tint?: string;        // overlay color (multiply)
  vignette?: number;    // 0..1
  fallbackBg?: string;  // when image missing
}> = ({ src, tint, vignette = 0.45, fallbackBg = PILLAR_A.dark }) => {
  return (
    <AbsoluteFill style={{ overflow: 'hidden', background: fallbackBg }}>
      <Img
        src={staticFile(src)}
        style={{
          width: '100%', height: '100%', objectFit: 'cover',
          filter: 'saturate(1.25) contrast(1.18) brightness(1.05)',
        }}
        onError={(e) => { (e.target as HTMLImageElement).style.display = 'none'; }}
      />
      {tint && <AbsoluteFill style={{ background: tint, mixBlendMode: 'multiply' }} />}
      <AbsoluteFill
        style={{
          background: `radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,${vignette}) 100%)`,
          pointerEvents: 'none',
        }}
      />
    </AbsoluteFill>
  );
};

// ───────── PILLAR BADGE (top-left, identifies pillar) ─────────
export const PillarBadge: React.FC<{ letter?: string; label?: string }> = ({
  letter = 'A',
  label = 'KHẨU PHẦN ĐẶC THÙ',
}) => (
  <div
    style={{
      position: 'absolute', top: 60, left: 60, zIndex: 10,
      display: 'flex', alignItems: 'center', gap: 14,
      background: COLOR.yellow, color: COLOR.ink,
      border: `${BORDER.base}px solid ${COLOR.outline}`,
      borderRadius: RADIUS.pill,
      padding: '12px 22px 12px 14px',
      boxShadow: SHADOW.stickerMd,
      fontFamily: FONT.heading, fontWeight: FW.extrabold,
      letterSpacing: 1.5, fontSize: 28,
    }}
  >
    <span style={{
      width: 44, height: 44, borderRadius: '50%',
      background: COLOR.outline, color: COLOR.yellow,
      display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
      fontFamily: FONT.display, fontWeight: 800, fontSize: 30,
    }}>{letter}</span>
    <span>{label}</span>
  </div>
);

// ───────── CHANNEL WATERMARK (top-right) ─────────
export const ChannelMark: React.FC = () => (
  <div
    style={{
      position: 'absolute', top: 60, right: 60, zIndex: 10,
      background: COLOR.outline, color: COLOR.yellow,
      border: `${BORDER.thin}px solid ${COLOR.outline}`,
      borderRadius: RADIUS.pill,
      padding: '10px 22px',
      boxShadow: SHADOW.stickerSm,
      fontFamily: FONT.display, fontWeight: 800,
      fontSize: 26, letterSpacing: 2, textTransform: 'uppercase',
    }}
  >
    Trạm Dừng Mlem
  </div>
);

// ───────── SUBTITLE KARAOKE (bottom) ─────────
// Splits text into words; each word can be highlighted at its segment.
export const SubtitleKaraoke: React.FC<{
  text: string;
  // optional per-word timings (fraction 0..1 of scene). If omitted, distributes evenly.
  perWord?: number[];
}> = ({ text, perWord }) => {
  const frame = useCurrentFrame();
  const { durationInFrames } = useVideoConfig();
  const words = text.split(/\s+/).filter(Boolean);
  const t = frame / Math.max(durationInFrames - 1, 1);
  const fade = interpolate(frame, [0, 8], [0, 1], { extrapolateRight: 'clamp' });

  return (
    <div
      style={{
        position: 'absolute', bottom: 220, left: 60, right: 60, zIndex: 9,
        display: 'flex', flexWrap: 'wrap', justifyContent: 'center', gap: '10px 14px',
        opacity: fade,
      }}
    >
      {words.map((w, i) => {
        const start = perWord?.[i] ?? i / Math.max(words.length, 1);
        const end = perWord?.[i + 1] ?? (i + 1) / Math.max(words.length, 1);
        const active = t >= start && t < end + 0.04;
        return (
          <span
            key={i}
            style={{
              fontFamily: FONT.body,
              fontWeight: FW.bold,
              fontSize: TYPE.caption.size,
              color: active ? COLOR.ink : COLOR.white,
              background: active ? COLOR.yellow : 'transparent',
              padding: active ? '4px 12px' : '4px 0',
              borderRadius: RADIUS.sm,
              ...(!active ? outlineText('body') : {}),
              transition: 'background 100ms',
              lineHeight: 1.3,
            }}
          >
            {w}
          </span>
        );
      })}
    </div>
  );
};

// ───────── STICKER CARD ─────────
export const StickerCard: React.FC<{
  bg?: string;
  borderColor?: string;
  shadow?: string;
  radius?: number;
  padding?: string | number;
  rotate?: number;
  style?: React.CSSProperties;
  children?: React.ReactNode;
}> = ({
  bg = COLOR.cream,
  borderColor = COLOR.outline,
  shadow = SHADOW.stickerLg,
  radius = RADIUS.xl,
  padding = '40px 48px',
  rotate = 0,
  style,
  children,
}) => (
  <div
    style={{
      background: bg,
      border: `${BORDER.thick}px solid ${borderColor}`,
      borderRadius: radius,
      boxShadow: shadow,
      padding,
      transform: `rotate(${rotate}deg)`,
      ...style,
    }}
  >
    {children}
  </div>
);

// ───────── ENTRY SPRING (sticker pop) ─────────
export const useEntry = (delay = 0, damping = 12) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  return spring({ frame: frame - delay, fps, config: { damping, mass: 0.8 } });
};

// ───────── ZOOM-PUNCH transition (last 13 frames of scene) ─────────
// Use as a wrapper applied to scene root: <ZoomPunch>{children}</ZoomPunch>
export const ZoomPunch: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const frame = useCurrentFrame();
  const { durationInFrames } = useVideoConfig();
  const remain = durationInFrames - frame;

  // entry: zoom-out enter (last 4 frames of prev scene → first 4 of this)
  const enterScale = interpolate(frame, [0, 4], [1.15, 1.0], {
    extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
  });
  // exit: zoom-in (last 6 frames before whip)
  const exitScale = interpolate(remain, [13, 7], [1.0, 1.15], {
    extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
  });
  const blur = interpolate(remain, [7, 4], [0, 30], {
    extrapolateLeft: 'clamp', extrapolateRight: 'clamp',
  });
  const scale = remain < 7 ? exitScale : enterScale;

  return (
    <div style={{
      width: '100%', height: '100%',
      transform: `scale(${scale})`,
      filter: `blur(${blur}px)`,
      transformOrigin: 'center center',
    }}>
      {children}
    </div>
  );
};

// ───────── SCENE FRAME (root container) ─────────
export const SceneFrame: React.FC<{
  bg?: string;
  withBadge?: boolean;
  withMark?: boolean;
  children?: React.ReactNode;
}> = ({ bg = COLOR.bgPage, withBadge = true, withMark = true, children }) => (
  <AbsoluteFill style={{ background: bg, overflow: 'hidden' }}>
    {children}
    {withBadge && <PillarBadge />}
    {withMark && <ChannelMark />}
  </AbsoluteFill>
);

// ───────── BIG OUTLINE TEXT ─────────
export const OutlineText: React.FC<{
  size?: number;
  color?: string;
  family?: string;
  weight?: number;
  variant?: 'hook' | 'body' | 'thin';
  align?: 'left' | 'center' | 'right';
  letterSpacing?: number;
  lineHeight?: number;
  shadow?: boolean;
  children: React.ReactNode;
}> = ({
  size = 140,
  color = COLOR.white,
  family = FONT.display,
  weight = 800,
  variant = 'hook',
  align = 'center',
  letterSpacing = -2,
  lineHeight = 1.0,
  shadow = true,
  children,
}) => (
  <div style={{
    fontFamily: family,
    fontWeight: weight,
    fontSize: size,
    lineHeight,
    letterSpacing,
    color,
    textAlign: align,
    ...outlineText(variant),
    textShadow: shadow ? `0 ${variant === 'hook' ? 8 : 4}px 0 ${COLOR.outline}` : undefined,
  }}>
    {children}
  </div>
);
